# Copy to .env and fill in locally. NEVER commit a real .env file.
# These are placeholder names only — no real values belong in this file.

# GitHub access token (used in a FUTURE phase; not called in Phase 0).
GITHUB_TOKEN=

# Internal LiteLLM OpenAI-compatible endpoint (intended default provider).
# Also the five names a controlled review reads when
# controlled_review.provider is "litellm" — and only then.
# Canonical AIDO_-prefixed names (Phase 3B). Required:
AIDO_LITELLM_BASE_URL=
AIDO_LITELLM_API_KEY=
AIDO_LITELLM_DEFAULT_MODEL=
# Optional (defaults: 30.0 seconds, 2 retries):
AIDO_LITELLM_TIMEOUT_SECONDS=
AIDO_LITELLM_MAX_RETRIES=

# Direct OpenAI-compatible vLLM endpoint (Phase 5F2E-V1). Read ONLY by
# `l2-review-approved-file-edit`, ONLY when the project config sets
# controlled_review.provider: "vllm", and ONLY after that command's verification
# stage has returned `verified`.
#
# That is literal, not aspirational (Phase 5F2E-V1-FU1): the configured provider
# is resolved to an exact tuple of variable NAMES before the process environment
# is touched at all. A "litellm" review never looks up either name below, and a
# "vllm" review never looks up any AIDO_LITELLM_* name.
#
# Required for a vLLM reviewer:
AIDO_VLLM_BASE_URL=
# Optional. Leave blank for a keyless vLLM server: AIDO then sends a fixed,
# NON-SECRET compatibility placeholder rather than a credential.
AIDO_VLLM_API_KEY=
# There is deliberately NO AIDO_VLLM_DEFAULT_MODEL. The reviewer model comes
# only from project_config.controlled_review.model.
