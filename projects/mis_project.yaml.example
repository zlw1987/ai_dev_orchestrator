# Example project workspace-boundary config.
# Copy to projects/<name>.yaml and edit. Contains NO secrets — boundaries only.

# Logical name for this project workspace.
name: mis_project

# Absolute path the orchestrator is allowed to operate within.
# All file changes (in future phases) must stay inside this root.
root: C:/dev/mis_project

# Paths (relative to root) the orchestrator may read/modify.
allow_paths:
  - documents/**
  - .github/ISSUE_TEMPLATE/**
  - .github/pull_request_template.md
  - .github/workflows/**
  - accounts/**
  - project_requests/**
  - external_auth/**
  - templates/**
  - config/**
  - requirements.txt
  - manage.py

# Sensitive paths that require extra review / stronger guards (even if allowed).
protected_paths:
  - config/settings.py
  - requirements.txt
  - external_auth/**
  - "**/migrations/**"
  - .github/workflows/**

# Paths the orchestrator must never read or modify, even if inside root.
forbidden_paths:
  - .git/**
  - .env
  - .venv/**
  - db.sqlite3
  - media/**
  - __pycache__/**
  - "*.pyc"
  - .ai_runs/**

# Default model provider for this project. Internal LiteLLM only in Phase 0.
provider: litellm

# Models exposed to this project (placeholder; not called in Phase 0).
models:
  default: minimax-m2.7
  alternates:
    - qwen3.6-27b

# Allowlisted checks the orchestrator may run (future phase; not executed yet).
allowed_checks:
  - pytest

# Controlled automation level (future phase; not enforced in Phase 0).
# L1 = plan-only (the orchestrator proposes a plan, makes no changes).
# Later phases may add L2/L3/L4 for progressively more automation.
automation_level: L1
