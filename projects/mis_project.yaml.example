# Example project config (EXAMPLE ONLY).
# Copy to projects/<name>.yaml and edit. Contains NO secrets — provider
# connection details are referenced by ENV VAR NAME only (see *_env fields).
# The workspace_path below is configuration/documentation only; Phase 1 code
# never reads or touches that folder.

project_id: mis_project
display_name: MIS_PROJECT

repo:
  workspace_path: "C:/dev/mis_project"
  github_repo: "zlw1987/mis_project"
  default_base_branch: "main"
  branch_prefix: "ai/mis"

workspace_policy:
  deny_outside_workspace: true
  allow_symlinks: false
  max_changed_files: 20

# Paths (relative to workspace) the orchestrator may read/modify.
allowed_paths:
  - "documents/**"
  - ".github/ISSUE_TEMPLATE/**"
  - ".github/pull_request_template.md"
  - ".github/workflows/**"
  - "accounts/**"
  - "project_requests/**"
  - "external_auth/**"
  - "templates/**"
  - "config/**"
  - "requirements.txt"
  - "manage.py"

# Sensitive paths requiring explicit authorization to modify (even if allowed).
protected_paths:
  - "config/settings.py"
  - "requirements.txt"
  - "external_auth/**"
  - "**/migrations/**"
  - ".github/workflows/**"

# Paths the orchestrator must never read or modify. Forbidden beats everything.
forbidden_paths:
  - ".git"
  - ".git/**"
  - ".env"
  - ".venv"
  - ".venv/**"
  - "db.sqlite3"
  - "media"
  - "media/**"
  - "__pycache__/**"
  - "**/__pycache__/**"
  - "*.pyc"
  - ".ai_runs"
  - ".ai_runs/**"

# Model providers. Default is the internal LiteLLM OpenAI-compatible endpoint.
# Secrets come from the named environment variables, never from this file.
providers:
  litellm_local:
    type: openai_compatible
    base_url_env: AIDO_LITELLM_BASE_URL
    api_key_env: AIDO_LITELLM_API_KEY
    timeout_seconds: 600
    default_headers:
      User-Agent: "Mozilla/5.0 (Windows NT 10.0; Win64; x64)"

ai_roles:
  implementer:
    provider: litellm_local
    model: minimax-m2.7
    temperature: 0.2
    max_tokens: 8192
    can_edit_files: true
  reviewer:
    provider: litellm_local
    model: qwen3.6-27b
    temperature: 0.1
    max_tokens: 8192
    can_edit_files: false
  fixer:
    provider: litellm_local
    model: minimax-m2.7
    temperature: 0.15
    max_tokens: 8192
    can_edit_files: true

# External integrations are OPTIONAL and disabled by default.
external_integrations:
  openai_api:
    enabled: false
  anthropic_api:
    enabled: false
  github_copilot_review:
    enabled: false
  codex_review:
    enabled: false

# Real model-backed L1 planning. DISABLED, and documentation only — nothing
# reads this block yet (no gate, no env read, no CLI command, no model call).
# An empty allowed_models list means NO model is permitted, even if enabled.
# Never put credentials or endpoints here; providers name env vars instead.
real_model_planning:
  enabled: false
  allowed_models: []
  allow_prompt_audit_files: false

# Read-only workspace metadata inspection (Phase 5D1). DISABLED. While disabled,
# `l2-inspect-workspace` refuses to touch this project's workspace at all — it
# fails before the approved-plan artifact is even opened. When enabled it may
# only canonicalize and stat the paths an approved plan lists under
# files_likely_to_change; it never reads file contents, never lists a directory,
# never runs a command, and never edits a file. Never put credentials here.
read_only_workspace_inspection:
  enabled: false
  max_inspected_files: 20
  allow_protected_paths: false

# Bounded read-only workspace file-CONTENT reads (Phase 5D2). DISABLED, and a
# separate opt-in from the metadata block above: agreeing that path names may be
# stat'd is not agreeing that this project's source may be printed. While
# disabled, `l2-read-workspace-files` refuses to touch this project's workspace
# at all — it fails before the approved-plan artifact is even opened. When
# enabled it may only read the paths an approved plan lists under
# files_likely_to_change, within the byte caps below, and every byte it prints
# passes through mandatory secret-like redaction (which has no off switch and is
# best-effort, not a guarantee). It still never lists a directory, never
# generates a diff, never edits a file, never runs a command, and never sends
# file contents to a model. Never put credentials here.
read_only_workspace_content:
  enabled: false
  max_files: 10
  max_file_bytes: 50000
  max_total_bytes: 200000
  allow_protected_paths: false

# Controlled single-file WRITES into this project's workspace (Phase 5F2C).
# DISABLED, and a third separate opt-in: agreeing that source may be read is not
# agreeing that it may be modified. While disabled, `l2-apply-approved-file-edit`
# refuses before the approved-diff artifact is even opened.
#
# When enabled, the writer can do exactly one thing: apply ONE explicitly
# human-approved modification to ONE existing, Git-tracked, ordinary UTF-8 file
# inside ONE wholly clean Windows Git repository whose top level is exactly
# workspace_path — transforming an exact approved pre-image into an exact
# approved post-image, and leaving the change uncommitted for human review.
#
# It cannot create, delete, or rename a file; cannot write more than one file
# (whatever workspace_policy.max_changed_files allows); cannot write a protected
# or forbidden path; cannot apply a diff with fuzz; cannot run this project's
# verification commands or any other command; and cannot call a model, open a
# socket, contact GitHub, create a branch, commit, push, or open a PR.
#
# There is deliberately NO allow_protected_paths here, no create flag, no
# multi-file switch, and no rollback/journal setting. Never put credentials here.
workspace_write:
  enabled: false
  max_file_bytes: 200000

run_limits:
  max_model_calls_per_issue: 20
  max_review_loops: 3
  max_ci_fix_loops: 2
  max_total_runtime_minutes: 60
